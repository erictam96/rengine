#
# General
#
COMPOSE_PROJECT_NAME=rengine

#
# SSL specific configuration
#
AUTHORITY_NAME=reNgine
AUTHORITY_PASSWORD=nSrmNkwT
COMPANY=reNgine
DOMAIN_NAME=rengine.example.com
COUNTRY_CODE=US
STATE=Georgia
CITY=Atlanta

#
# Database configurations
#
POSTGRES_DB=rengine
POSTGRES_USER=rengine
POSTGRES_PASSWORD=hE2a5@K&9nEY1fzgA6X
POSTGRES_PORT=5432
POSTGRES_HOST=db

#
# Celery Scaling Configurations
#
MAX_CONCURRENCY=80
MIN_CONCURRENCY=10

#
# Rengine web interface super user (for non-interactive install)
#
DJANGO_SUPERUSER_USERNAME=rengine
DJANGO_SUPERUSER_EMAIL=rengine@example.com
DJANGO_SUPERUSER_PASSWORD=Sm7IJG.IfHAFw9snSKv

#
# LLM providers (optional)
#
# Point Ollama at another host, e.g. a GPU box: http://10.0.0.5:11434
OLLAMA_INSTANCE=http://ollama:11434
# Use any OpenAI-compatible server (LM Studio, vLLM, OpenRouter...). Empty = api.openai.com
OPENAI_BASE_URL=

#
# CVE lookups (optional) - NVD API key raises the rate limit from 5 to 50 req / 30s
# https://nvd.nist.gov/developers/request-an-api-key
#
NVD_API_KEY=

#
# Ports (host side). reNgine sits behind an outer nginx reverse proxy
# (nothing2scan.com -> https://127.0.0.1:4430), so it only listens on loopback.
# For a standalone install use RENGINE_BIND_ADDRESS=0.0.0.0 and RENGINE_HTTPS_PORT=443.
#
RENGINE_BIND_ADDRESS=127.0.0.1
RENGINE_HTTPS_PORT=4430
RENGINE_HTTP_PORT=8082
# Only needed if reNgine is opened on a host/port the browser sends as Origin
# that differs from the proxied Host header, comma-separated.
CSRF_TRUSTED_ORIGINS=https://nothing2scan.com
